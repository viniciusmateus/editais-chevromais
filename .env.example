# Conexão PostgreSQL (copie para .env). Sem DATABASE_URL o sistema usa data/db.json.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO
# DATABASE_SSL=1
# Banco na VPS (só acessível por SSH): o servidor abre o túnel sozinho. DATABASE_URL deve usar localhost e a porta 15432.
# SSH_TUNNEL=root@198.50.117.238
